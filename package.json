{
  "name": "docfields",
  "version": "0.1.0",
  "private": true,
  "description": "Invoice field extraction with validation in code and a human review screen",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "samples": "tsx scripts/make-samples.ts",
    "eval": "tsx src/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run eval"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "unpdf": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
